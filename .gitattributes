# Auto detect text files and normalize to LF
* text=auto eol=lf

# Documents
*.md text
*.txt text

# Source code
*.js text
*.json text
*.yaml text
*.yml text
*.tf text
*.sh text eol=lf

# Config files
.env* text
*.ini text
*.conf text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.tar binary
*.gz binary
*.pdf binary

# Lock files
package-lock.json text eol=lf linguist-generated=true
